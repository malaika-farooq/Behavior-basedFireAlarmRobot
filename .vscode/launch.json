	"version": "0.2.0",
	"configurations": [
		{
			"name": "1. Calibrate (download and run)",
			"type": "ev3devBrowser",
			"request": "launch",
			"program": "/home/robot/${workspaceRootFolderName}/tools/calibrate.py",
			"interactiveTerminal": false
		},
		{
			"name": "2. Fire Robot main.py (download and run)",
			"type": "ev3devBrowser",
			"request": "launch",
			"program": "/home/robot/${workspaceRootFolderName}/main.py",
			"interactiveTerminal": false
		},
		{
			"name": "3. Stop all motors",
			"type": "ev3devBrowser",
			"request": "launch",
			"program": "/home/robot/${workspaceRootFolderName}/tools/stop.py",
			"interactiveTerminal": false
		}
	]
}
